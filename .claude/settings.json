{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "NotebookEdit",
      "WebSearch",
      "WebFetch",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git rev-parse)",
      "Bash(git rev-parse *)",
      "Bash(git branch)",
      "Bash(git branch --list *)",
      "Bash(git branch -r)",
      "Bash(git branch -r *)",
      "Bash(git branch -a)",
      "Bash(git branch -v)",
      "Bash(git branch -vv)",
      "Bash(git remote)",
      "Bash(git remote -v)",
      "Bash(git remote show *)",
      "Bash(git stash list *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "mcp__ide__*"
    ],
    "deny": [
      "Read(/secrets/**)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)",
      "Read(./**/*.crt)",
      "Edit(/secrets/**)",
      "Edit(./**/*.key)",
      "Edit(./**/*.pem)",
      "Edit(./**/*.crt)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Edit(./**/.env)",
      "Edit(./**/.env.*)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(shred *)",
      "Bash(unlink *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(fdisk *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git push --force *)",
      "Bash(git pull *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Bash(git tag *)",
      "Bash(git fetch *)",
      "Bash(git stash *)",
      "Bash(git cherry-pick *)",
      "Bash(git am *)",
      "Bash(git apply *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git remote add *)",
      "Bash(git remote remove *)",
      "Bash(git remote set-url *)",
      "Bash(gh *)",
      "Bash(npm publish)",
      "Bash(npm publish *)",
      "Bash(npm unpublish *)",
      "Bash(npm deprecate *)",
      "Bash(npm access *)",
      "Bash(npm owner *)",
      "Bash(npm token *)",
      "Bash(npm login)",
      "Bash(npm logout)",
      "Bash(npm adduser)",
      "Bash(kill *)",
      "Bash(killall *)",
      "Bash(pkill *)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "outputStyle": "Explanatory",
  "alwaysThinkingEnabled": true
}
