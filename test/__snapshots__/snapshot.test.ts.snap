// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`snapshot manifests (v1) > capabilitiesManifest lists names only 1`] = `
{
  "prompts": [
    "greet",
  ],
  "resources": [
    "demo://greeting",
  ],
  "tools": [
    "boom",
    "echo",
    "slow",
    "weather",
    "weather-bad",
    "weather-strict",
  ],
}
`;

