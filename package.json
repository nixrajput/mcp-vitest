{
  "name": "mcp-vitest",
  "version": "0.5.1",
  "description": "Vitest-native testing for Model Context Protocol (MCP) servers - matchers, snapshots, interaction doubles, and real external servers, on both SDK majors.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./matchers": {
      "types": "./dist/matchers.d.ts",
      "default": "./dist/matchers.js"
    },
    "./setup": {
      "types": "./dist/setup.d.ts",
      "default": "./dist/setup.js"
    },
    "./snapshot": {
      "types": "./dist/snapshot.d.ts",
      "default": "./dist/snapshot.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "default": "./dist/auth.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown --entry.index=src/index.ts --entry.matchers=src/matchers.ts --entry.setup=src/setup.ts --entry.snapshot=src/snapshot.ts --entry.auth=src/auth/index.ts --format esm --dts --no-fixed-extension && publint && attw --pack . --profile esm-only",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "ts:check": "tsc --noEmit && node scripts/check-no-node-globals.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "report": "node scripts/report.mjs",
    "report:fast": "node scripts/report.mjs --fast",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@modelcontextprotocol/client": "^2.3.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@modelcontextprotocol/server": "^2.3.0",
    "vitest": "^4.1.12 || ^5.0.3"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "@modelcontextprotocol/client": {
      "optional": true
    },
    "@modelcontextprotocol/server": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.6.8",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "4.1.12",
    "knip": "6.48.0",
    "publint": "0.3.25",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "zod": "4.6.7"
  },
  "homepage": "https://mcp-vitest.nixrajput.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nixrajput/mcp-vitest.git"
  },
  "bugs": "https://github.com/nixrajput/mcp-vitest/issues",
  "author": "Nikhil Rajput (https://github.com/nixrajput)",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "vitest",
    "testing",
    "test-harness",
    "matchers",
    "typescript"
  ],
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1"
  }
}
